rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Catch-all safety gate (Absolute Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Shared Global primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Check if user is email-verified
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // 2. Validation Blueprints (Anti-Update-Gaps)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName'])
        && data.keys().size() <= 6
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 256
        && (data.role == null || (data.role is string && data.role.size() <= 128))
        && (data.country == null || (data.country is string && data.country.size() <= 128));
    }

    function isValidSovereignAssessment(data) {
      return data.keys().hasAll(['id', 'countryId', 'countryName', 'creatorId', 'ari', 'gsv', 'itc'])
        && data.keys().size() <= 16
        && data.id is string && data.id.size() <= 128
        && data.countryId is string && data.countryId.size() <= 64
        && data.countryName is string && data.countryName.size() <= 128
        && data.creatorId is string && data.creatorId.size() <= 128
        && data.ari is number && data.ari >= 0.0 && data.ari <= 10.0
        && data.gsv is number && data.gsv >= 0.0 && data.gsv <= 10.0
        && data.itc is number && data.itc >= 0.0 && data.itc <= 10.0
        && (data.sdr == null || (data.sdr is number && data.sdr >= 0.0 && data.sdr <= 10.0))
        && (data.afl == null || (data.afl is number && data.afl >= 0.0 && data.afl <= 10.0))
        && (data.lic == null || (data.lic is number && data.lic >= 0.0 && data.lic <= 10.0))
        && (data.sfp == null || (data.sfp is number && data.sfp >= 0.0 && data.sfp <= 100.0))
        && (data.classification == null || (data.classification is string && data.classification.size() <= 128))
        && (data.bindingConstraint == null || (data.bindingConstraint is string && data.bindingConstraint.size() <= 128))
        && (data.formSubmissionId == null || (data.formSubmissionId is string && data.formSubmissionId.size() <= 128));
    }

    function isValidEvidenceAttachment(data) {
      return data.keys().hasAll(['fileId', 'fileName', 'targetIndicator', 'linkedAssessmentId'])
        && data.keys().size() <= 8
        && data.fileId is string && data.fileId.size() <= 128
        && data.fileName is string && data.fileName.size() <= 256
        && data.targetIndicator is string && data.targetIndicator.size() <= 256
        && data.linkedAssessmentId is string && data.linkedAssessmentId.size() <= 128
        && (data.ownerEmail == null || (data.ownerEmail is string && data.ownerEmail.size() <= 256))
        && (data.hashSignature == null || (data.hashSignature is string && data.hashSignature.size() <= 128));
    }

    // 4. MATCH BLOCKS FOR WORKSPACE COLLECTIONS

    // USER PROFILES SECTION
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() 
                    && isOwner(userId) 
                    && isValidId(userId) 
                    && isValidUserProfile(incoming());
      
      allow update: if isSignedIn() 
                    && isOwner(userId) 
                    && isValidUserProfile(incoming())
                    && incoming().uid == existing().uid
                    && incoming().email == existing().email
                    && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'country', 'updatedAt']);
      
      allow delete: if isOwner(userId);
    }

    // SOVEREIGN DIAGNOSTIC RECORDS SECTION
    match /assessments/{assessmentId} {
      // Security Query Enforcer for lists: MUST mandate creator check
      allow list: if isSignedIn() && (resource == null || resource.data.creatorId == request.auth.uid);
      allow get: if isSignedIn();

      allow create: if isVerifiedUser()
                    && isValidId(assessmentId)
                    && isValidSovereignAssessment(incoming())
                    && incoming().creatorId == request.auth.uid;

      // Tiered Action Updates: Only allowed creators can modify properties or attachments; immutable locks applied
      allow update: if isVerifiedUser()
                    && incoming().creatorId == request.auth.uid
                    && existing().creatorId == request.auth.uid
                    && isValidSovereignAssessment(incoming())
                    && incoming().id == existing().id
                    && incoming().creatorId == existing().creatorId
                    && incoming().countryId == existing().countryId
                    && (
                      // Action: Edit assessment properties and recalibrate metrics
                      incoming().diff(existing()).affectedKeys().hasAny(['ari', 'gsv', 'itc', 'sdr', 'afl', 'lic', 'sfp', 'classification', 'bindingConstraint', 'formSubmissionId'])
                    );

      allow delete: if isVerifiedUser() && existing().creatorId == request.auth.uid;

      // EVIDENCE SUBCOLLECTION SECTOR (Master Gate connection to parent assessment)
      match /evidence/{evidenceId} {
        allow list: if isSignedIn() && get(/databases/$(database)/documents/assessments/$(assessmentId)).data.creatorId == request.auth.uid;
        allow get: if isSignedIn();

        allow create: if isVerifiedUser()
                      && isValidId(evidenceId)
                      && isValidEvidenceAttachment(incoming())
                      && incoming().linkedAssessmentId == assessmentId
                      && get(/databases/$(database)/documents/assessments/$(assessmentId)).data.creatorId == request.auth.uid;

        allow update: if isVerifiedUser()
                      && isValidEvidenceAttachment(incoming())
                      && incoming().fileId == existing().fileId
                      && incoming().linkedAssessmentId == existing().linkedAssessmentId
                      && get(/databases/$(database)/documents/assessments/$(assessmentId)).data.creatorId == request.auth.uid
                      && incoming().diff(existing()).affectedKeys().hasOnly(['fileName', 'targetIndicator', 'ownerEmail', 'hashSignature']);

        allow delete: if isVerifiedUser() 
                      && get(/databases/$(database)/documents/assessments/$(assessmentId)).data.creatorId == request.auth.uid;
      }
    }
  }
}
